# Copy this file to .env and fill it in. Never share or upload .env.

# Admin login, created on first start (password 8+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Set to true ONLY on your own computer to try the site with fake payments. Refused in production.
DEMO_PAYMENTS=true

# Razorpay keys (Dashboard > Account & Settings > API Keys). Start with Test keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when you create the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# Set to production when the site is live on HTTPS
APP_ENV=development
PORT=5000
# Where the database file lives. On a host, use a persistent disk path such as /data/plateclub.db
DB_PATH=./plateclub.db
